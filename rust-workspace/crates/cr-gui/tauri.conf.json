{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ChronoKeep",
  "version": "0.1.8",
  "identifier": "com.chronokeep.app",
  "build": {
    "frontendDist": "ui"
  },
  "bundle": {
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ]
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "ChronoKeep",
        "width": 1050,
        "height": 700,
        "minWidth": 850,
        "minHeight": 580,
        "resizable": true,
        "fullscreen": false,
        "transparent": true,
        "decorations": true
      }
    ],
    "security": {
      "csp": null
    }
  }
}

